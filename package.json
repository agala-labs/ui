{
  "name": "@agala-labs/ui",
  "version": "0.39.0",
  "description": "Agala Labs UI — accessible Vue 3 components, semantic design tokens, and theming.",
  "type": "module",
  "module": "./dist/agala-ui.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/agala-ui.es.js"
      }
    },
    "./reset.css": "./dist/reset.css",
    "./themes/main.css": "./dist/themes/main.css",
    "./themes/smaltt.css": "./dist/themes/smaltt.css",
    "./themes/kervo.css": "./dist/themes/kervo.css"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test:mobile": "playwright test",
    "test:consumer": "node scripts/smoke-consumer.mjs",
    "build:lib": "vue-tsc --noEmit && vite build && cp src/lib/reset.css dist/reset.css && node -e \"require('fs').rmSync('dist/themes',{recursive:true,force:true})\" && mkdir -p dist/themes dist/licenses && cp src/lib/themes/*.css dist/themes/ && cp node_modules/@lucide/vue/LICENSE dist/licenses/lucide.txt && cp dist/agala-ui.es.js dist/agala-ui.browser.js && node -e \"require('fs').writeFileSync('dist/agala-ui.browser.js', require('fs').readFileSync('dist/agala-ui.es.js','utf-8').replace(/import '\\.\\/index\\.css';[^\\n]*\\n?/g, ''))\"",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepublishOnly": "npm run build:lib"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "eslint": "^10.2.1",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.5.0",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vite-plugin-dts": "^4.5.3",
    "vite-plugin-lib-inject-css": "^2.2.1",
    "vitepress": "^1.6.4",
    "vue-tsc": "^3.2.8"
  },
  "dependencies": {
    "@floating-ui/vue": "^2.0.1",
    "@lucide/vue": "^1.25.0",
    "date-fns": "^4.1.0",
    "markdown-it": "^14.2.0",
    "vue": "^3.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agala-labs/ui.git"
  },
  "author": "Agala Labs",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "vue",
    "vue3",
    "ui",
    "components",
    "design-system",
    "agala",
    "zero-dependency",
    "theming",
    "accessibility"
  ],
  "workspaces": [
    "packages/charts"
  ]
}
