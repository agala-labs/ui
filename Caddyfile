{
  admin off
  auto_https off
  persist_config off
}

:8080 {
  root * /srv

  respond /healthz 200

  @hashedAssets path_regexp hashed ^/assets/.*\.[A-Za-z0-9_-]{8,}\.(css|js|woff2?|png|jpe?g|gif|svg|webp|avif)$
  header @hashedAssets Cache-Control "public, max-age=31536000, immutable"

  @html path *.html /
  header @html Cache-Control "public, max-age=0, must-revalidate"

  try_files {path} {path}.html {path}/index.html
  file_server
}
